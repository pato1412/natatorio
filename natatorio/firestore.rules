rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isProfesor() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'profesor';
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
    }

    match /times/{timeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.recordedBy == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.recordedBy == request.auth.uid;
    }

    match /estilos/{estiloId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isProfesor();
    }

    match /distancias/{distanciaId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isProfesor();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isProfesor();
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
